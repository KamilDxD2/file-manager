<div class="Upload">
    <div class="Left">
        <h1>filemanager</h1>
        <a href="/reset">USUŃ DANE O PLIKACH Z TABLICY</a>
    </div>
    <div class="Table">
        <table>
            <tr>
                <th>id</th>
                <th>obraz</th>
                <th>name</th>
                <th>size</th>
                <th>type</th>
                <th>-</th>
                <th>-</th>
                <th>-</th>
                <th>-</th>
            </tr>
            {{#each TAB}}
            <tr>
                <td>{{PONE id}}</td>
                <td><img src="../gfx/{{EXT data.name}}.png"></td>
                <td>{{data.name}}</td>
                <td>{{data.size}}</td>
                <td>{{data.type}}</td>
                <td><a href="/show/{{PONE id}}">SHOW</a></td>
                <td><a href="/info/{{PONE id}}">INFO</a></td>
                <td><a href="/download/{{PONE id}}">DOWNLOAD</a></td>
                <td><a href="/delete/{{@index}}">DELETE</a></td>
            </tr>
            {{/each}}
        </table>
    </div>
</div>